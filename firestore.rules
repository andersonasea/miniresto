rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasProfile() {
      return signedIn() && exists(profilePath());
    }
    function role() {
      return get(profilePath()).data.role;
    }
    function isSuperAdmin() {
      return hasProfile() && role() == 'super_admin';
    }
    function isSales() {
      return hasProfile() && (role() == 'super_admin' || role() == 'sales_manager');
    }
    function isStock() {
      return hasProfile() && (role() == 'super_admin' || role() == 'stock_manager');
    }

    match /products/{id} {
      allow read: if true;
      allow create, delete: if isStock();
      allow update: if isStock() || (
        isSales() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock <= resource.data.stock
      );
    }
    match /sales/{id} {
      allow read, write: if isSales();
    }
    match /supplies/{id} {
      allow read, write: if isStock();
    }
    match /users/{id} {
      allow read: if signedIn() && (request.auth.uid == id || isSuperAdmin());
      allow create: if signedIn() && (
        (request.auth.uid == id && request.resource.data.role == 'super_admin') ||
        isSuperAdmin()
      );
      allow update, delete: if isSuperAdmin();
    }
  }
}
